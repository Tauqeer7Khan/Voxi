# voxi — Environment Variables
# Copy this to .env and fill in your values

# Ollama Settings
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://localhost:11434

# Whisper Settings
WHISPER_MODEL=small

# Assistant Name
ASSISTANT_NAME=voxi

# TTS Engine (pyttsx3 / edge-tts / kokoro)
TTS_ENGINE=pyttsx3

# Future Paid APIs (leave empty for free version)
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

